# a2ed94700ed61d574dafaeeb11fd8b9991ae45bd5f0d3f9038d2c36d418727e5 Elan 2.0.0-beta3 valid

function bestFitLine(points as List<of Point>) returns (Float, Float)
  variable sumX set to points.sumBy(lambda p as Point => p.x)
  variable sumXsq set to points.sumBy(lambda p as Point => p.x*p.x)
  variable sumY set to points.sumBy(lambda p as Point => p.y)
  variable sumXY set to points.sumBy(lambda p as Point => p.x*p.y)
  variable n set to points.length()
  variable a set to (sumY*sumXsq - sumX*sumXY)/(n*sumXsq - sumX*sumX)
  variable b set to (n*sumXY - sumX*sumY)/(n*sumXsq - sumX*sumX)
  return (a, b)
end function

class Point
  constructor(x as Float, y as Float)
    assign this.x to x
    assign this.y to y
  end constructor

  property x as Float

  property y as Float

  function toString() returns String
    return $"Point {this.x}, {this.y}"
  end function

end class

function newPoint(x as Float, y as Float) returns Point
  return new Point(x, y)
end function

test test_bestFit
  variable l1 set to [newPoint(0.71, 1.12), newPoint(3.56, 5.36), newPoint(7.83, 9.04)]
  variable a_b set to bestFitLine(l1)
  variable a set to a_b.item_0
  variable b set to a_b.item_1
  assert a.round(3) evaluates to 0.766
  assert b.round(3) evaluates to 1.093
end test

test test_bestFit_empty
  variable l1 set to new List<of Point>()
  variable a_b set to bestFitLine(l1)
  # NaN means 'Not A Number"
  assert a_b.toString() evaluates to "(NaN, NaN)"
end test

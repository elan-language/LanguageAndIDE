# cd09ceef1000e941a47520f33f3ea0ecb4c7d584de0480443375f389e5472b68 Elan 2.0.0-beta4 valid

main
  variable t set to new Turtle()
  call t.placeAt(-100, 75)
  call t.turnToHeading(90)
  for i in rangeInSteps(150, -1, -5)
    call t.move(i)
    call t.turn(90)
    call sleep_ms(300)
  end for
end main

# 521ece88dbb98fd2e9b790008dd0a2128c83e14965485a1849bef6d64b7e8357 Elan 2.0.0-beta3 valid

main
  variable t set to new Turtle()
  call t.placeAt(-100, 75)
  call t.turnToHeading(90)
  for i in rangeInSteps(150, -1, -5)
    call t.move(i)
    call t.turn(90)
    call sleep_ms(300)
  end for
end main

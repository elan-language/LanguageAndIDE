# bf8c555067d21add58587e68ad1d1c2ee68de7d4529c83c569aa8f7a9dcebbaf Elan 2.0.0-beta5 valid

main
  variable t set to new Turtle()
  call t.placeAt(-100, 75)
  call t.turnToHeading(90)
  for i in rangeInSteps(150, -1, -5)
    call t.move(i)
    call t.turn(90)
    call sleep_ms(300)
  end for
end main

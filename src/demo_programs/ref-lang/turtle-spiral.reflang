# bfe6dce51e9e09610e5d2afdb39b7019958202d036f3eab47fc7b7fa9e1c10a8 RefLang with Elan 3.0.0-alpha valid

main
  variable t set to new Turtle()
  call t.placeAt(-100, 75)
  call t.turnToHeading(90)
  for i in rangeInSteps(150, -1, -5)
    call t.move(i)
    call t.turn(90)
    call sleep_ms(300)
  end for
end main

# dcfce3c6e2bf7117d49349f549f54ae1371bff081c3aeac967a73981ca4629b3 Elan 3.0.0-alpha valid

main
  variable t set to new Turtle()
  call t.placeAt(-100, 75)
  call t.turnToHeading(90)
  for i in rangeInSteps(150, -1, -5)
    call t.move(i)
    call t.turn(90)
    call sleep_ms(300)
  end for
end main

# 6ecd8a13114d4dd1ef6b4a619aeb69e02ccb0877ab0e9b1b0bee2059d540a4c5 Elan 2.0.0-beta4 valid

# Use the W,A,S,D keys to change Snake direction
main
  variable blocks set to createBlockGraphics(white)
  variable rnd set to new Random()
  call rnd.initialiseFromClock()
  variable game set to (new Game(rnd)).withNewApple()
  while game.isOn
    assign blocks to updateGraphics(game, blocks)
    call displayBlocks(blocks)
    call sleep_ms(150)
    assign game to clockTick(game, getKey())
  end while
  print($"Game Over! Score: {score(game)}")
end main

function clockTick(g as Game, k as String) returns Game
  variable g2 set to if_(k.equals(""), g, g.with_key(k))
  variable g3 set to moveSnake(g2)
  variable g4 set to eatAppleIfPoss(g3)
  return if_(gameOver(g4), g4.with_isOn(false), g4)
end function

function updateGraphics(g as Game, b as List<of List<of Int>>) returns List<of List<of Int>>
  variable b2 set to graphicsPut(b, g.apple.x, g.apple.y, red)
  variable b3 set to graphicsPut(b2, g.head.x, g.head.y, green)
  variable tail set to g.body[0]
  variable tailColour set to if_(tail.equals(g.priorTail), green, white)
  return graphicsPut(b3, tail.x, tail.y, tailColour)
end function

function graphicsPut(graphics as List<of List<of Int>>, x as Int, y as Int, colour as Int) returns List<of List<of Int>>
  return graphics.withPut(x, graphics[x].withPut(y, colour))
end function

function score(g as Game) returns Int
  return g.body.length() - 2
end function

function moveSnake(g as Game) returns Game
  variable k set to g.key
  variable x set to g.head.x
  variable y set to g.head.y
  variable newX set to if_(k.equals("a"), x - 1, if_(k.equals("d"), x + 1, x))
  variable newY set to if_(k.equals("w"), y - 1, if_(k.equals("s"), y + 1, y))
  return g.with_body(g.body.withAppend(g.head)).with_head(new Square(newX, newY))
end function

function eatAppleIfPoss(g as Game) returns Game
  variable tail set to g.body[0]
  variable moveTail set to g.body.subList(1, g.body.length())
  return if_(headOverApple(g), g.withNewApple(), g.with_priorTail(tail).with_body(moveTail))
end function

function headOverApple(g as Game) returns Boolean
  return g.head.equals(g.apple)
end function

function gameOver(g as Game) returns Boolean
  return g.body.contains(g.head) or hasHitEdge(g)
end function

function hasHitEdge(g as Game) returns Boolean
  variable x set to g.head.x
  variable y set to g.head.y
  return (x is -1) or (y is -1) or (x is 40) or (y is 30)
end function

class Game
  constructor(rnd as Random)
    assign this.head to new Square(22, 15)
    assign this.body to [new Square(20, 15), new Square(21, 15)]
    assign this.priorTail to new Square(0, 0)
    assign this.key to "d"
    assign this.isOn to true
    assign this.apple to new Square(12, 15)
    assign this.rnd to rnd
  end constructor

  property head as Square

  property body as List<of Square>

  property priorTail as Square

  property apple as Square

  property isOn as Boolean

  property rnd as Random

  property key as String

  function toString() returns String
    return "a Game"
  end function

  function withNewApple() returns Game
    variable x set to this.rnd.asInt(0, 39)
    variable rnd2 set to this.rnd.nextGen()
    variable y set to rnd2.asInt(0, 29)
    variable rnd3 set to rnd2.nextGen()
    variable apple2 set to new Square(x, y)
    variable g2 set to this.with_apple(apple2).with_rnd(rnd3)
    return if_(g2.body.contains(apple2), g2.withNewApple(), g2)
  end function

  function with_head(head as Square) returns Game
    return copyWith(this, "head", head)
  end function

  function with_body(body as List<of Square>) returns Game
    return copyWith(this, "body", body)
  end function

  function with_priorTail(priorTail as Square) returns Game
    return copyWith(this, "priorTail", priorTail)
  end function

  function with_apple(apple as Square) returns Game
    return copyWith(this, "apple", apple)
  end function

  function with_isOn(isOn as Boolean) returns Game
    return copyWith(this, "isOn", isOn)
  end function

  function with_rnd(rnd as Random) returns Game
    return copyWith(this, "rnd", rnd)
  end function

  function with_key(key as String) returns Game
    return copyWith(this, "key", key)
  end function

end class

class Square
  constructor(x as Int, y as Int)
    assign this.x to x
    assign this.y to y
  end constructor

  property x as Int

  property y as Int

  function toString() returns String
    return $"{this.x}, {this.y}"
  end function

end class

test test_clockTick
  variable g1 set to new Game(new Random())
  variable g2 set to g1.withNewApple()
  variable g3 set to clockTick(g2, "s")
  assert g3.head evaluates to new Square(22, 16)
  assert g3.body.length() evaluates to 2
  assert g3.priorTail evaluates to g2.body[0]
  assert g3.isOn evaluates to true
  variable g4 set to g3.with_apple(new Square(22, 17))
  variable g5 set to clockTick(g4, "s")
  assert g5.body.length() evaluates to 3
  assert g5.priorTail evaluates to g4.priorTail
  assert g5.isOn evaluates to true
  variable g6 set to g5.with_head(new Square(22, 29))
  variable g7 set to clockTick(g6, "s")
  assert g7.isOn evaluates to false
end test

test test_updateGraphics
  variable blocks set to createBlockGraphics(white)
  variable g1 set to new Game(new Random())
  variable blocks2 set to updateGraphics(g1, blocks)
  assert blocks2[12][15] evaluates to red
  assert blocks2[22][15] evaluates to green
  assert blocks2[21][15] evaluates to white
  variable g3 set to clockTick(g1, "d")
  variable blocks3 set to updateGraphics(g3, blocks2)
  assert blocks3[12][15] evaluates to red
  assert blocks3[22][15] evaluates to green
  assert blocks3[23][15] evaluates to green
end test

test test_testnewApple
  variable g1 set to new Game(new Random())
  assert g1.apple evaluates to new Square(12, 15)
  variable g2 set to g1.withNewApple()
  assert g2.apple evaluates to new Square(12, 15)
  variable g3 set to g2.withNewApple()
  assert g3.apple evaluates to new Square(10, 12)
  # test that apple is never over snake
  variable g4 set to (new Game(new Random()))
  variable g5 set to g4.with_body([new Square(10, 12)])
  variable g6 set to g5.withNewApple()
  assert g4.apple evaluates to new Square(12, 15)
end test

test test_score
  variable g1 set to new Game(new Random())
  assert score(g1) evaluates to 0
  variable g2 set to g1.with_body([new Square(4, 4), new Square(5, 4)])
  assert score(g2) evaluates to 0
  variable g3 set to g1.with_body([new Square(3, 4), new Square(4, 4), new Square(5, 4)])
  assert score(g3) evaluates to 1
  variable g4 set to g1.with_body([new Square(3, 4), new Square(4, 4), new Square(5, 4), new Square(5, 5)])
  assert score(g4) evaluates to 2
end test

test test_moveSnake
  variable g1 set to new Game(new Random())
  variable g2 set to g1.with_key("a")
  variable g3 set to moveSnake(g2)
  assert g3.head evaluates to new Square(21, 15)
  variable g4 set to g1.with_key("d")
  variable g5 set to moveSnake(g4)
  assert g5.head evaluates to new Square(23, 15)
  variable g6 set to g1.with_key("w")
  variable g7 set to moveSnake(g6)
  assert g7.head evaluates to new Square(22, 14)
  variable g8 set to g1.with_key("s")
  variable g9 set to moveSnake(g8)
  assert g9.head evaluates to new Square(22, 16)
end test

test test_eatAppleIfPoss
  variable g1 set to new Game(new Random())
  assert g1.body.length() evaluates to 2
  # negative case
  variable g2 set to g1.with_apple(new Square(23, 15))
  variable g3 set to eatAppleIfPoss(g2)
  assert g3.body.length() evaluates to 1
  assert g3.apple evaluates to g2.apple
  assert g3.priorTail evaluates to g2.body[0]
  # positive case
  variable g4 set to g2.with_head(new Square(23, 15))
  variable g5 set to eatAppleIfPoss(g4)
  assert g5.body.length() evaluates to 2
  assert g5.apple evaluates to new Square(12, 15)
  assert g5.priorTail evaluates to g1.priorTail
end test

test test_overApple
  variable g1 set to new Game(new Random())
  variable g2 set to g1.with_apple(new Square(23, 15))
  assert headOverApple(g2) evaluates to false
  variable g3 set to g2.with_head(new Square(23, 15))
  assert headOverApple(g3) evaluates to true
end test

test test_gameOver
  variable g1 set to new Game((new Random()))
  assert gameOver(g1) evaluates to false
  variable g2 set to g1.with_head(new Square(0, 0))
  assert gameOver(g2) evaluates to false
  variable g3 set to g1.with_head(new Square(40, 15))
  assert gameOver(g3) evaluates to true
  variable g4 set to g1.with_head(new Square(21, 15))
  assert gameOver(g4) evaluates to true
end test

test test_headIsAtEdge
  variable g1 set to new Game(new Random())
  assert hasHitEdge(g1) evaluates to false
  variable g2 set to g1.with_head(new Square(40, 15))
  assert hasHitEdge(g2) evaluates to true
  variable g3 set to g1.with_head(new Square(-1, 15))
  assert hasHitEdge(g3) evaluates to true
  variable g4 set to g1.with_head(new Square(20, 30))
  assert hasHitEdge(g4) evaluates to true
  variable g5 set to g1.with_head(new Square(20, -1))
  assert hasHitEdge(g5) evaluates to true
end test

test test_newSquare
  variable sq set to new Square(3, 4)
  assert sq.x evaluates to 3
  assert sq.y evaluates to 4
end test

test test_newGame
  variable rnd set to new Random()
  variable game set to new Game(rnd)
  variable totest set to game.rnd.equals(rnd)
  assert totest evaluates to true
  assert game.head evaluates to new Square(22, 15)
  variable body set to game.body
  assert body.length() evaluates to 2
  assert body[0] evaluates to new Square(20, 15)
  assert body[1] evaluates to new Square(21, 15)
  assert game.priorTail evaluates to new Square(0, 0)
  assert game.key evaluates to "d"
  assert game.isOn evaluates to true
end test

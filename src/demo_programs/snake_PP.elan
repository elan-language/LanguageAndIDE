# 74bede9b5632ec0c8313d544244914c64ebf527049804fb01c62662e111570a5 Elan 2.0.0-beta5 valid

# Use the w,a,s,d keys to change snake's direction
constant width set to 40

constant height set to 30

main
  variable bg set to new BlockGraphics()
  variable head set to 621
  variable snake set to [head - 1, head]
  variable currentDir set to "d"
  variable gameOn set to true
  variable apple set to -1
  while gameOn
    while (apple is -1) or snake.contains(apple)
      assign apple to randint(0, width*height)
    end while
    call updateDisplay(bg, snake, apple)
    variable key set to getKey()
    if not key.equals("") and "wasd".contains(key) then
      assign currentDir to key
    end if
    assign head to getAdjacentBlock(head, currentDir)
    if (head is -1) or snake.contains(head) then
      assign gameOn to false
    else
      call snake.append(head)
    end if
    if head.equals(apple) then
      assign apple to -1
    else
      call snake.removeAt(0)
    end if
    call sleep_ms(150)
  end while
  print($"Game Over! Score: {snake.length() - 1}")
end main

procedure updateDisplay(bg as BlockGraphics, snake as List<of Int>, apple as Int)
  call bg.colourAll(white)
  for bl in snake
    call bg.putBlockNo(bl, green)
  end for
  call bg.putBlockNo(apple, red)
  call displayBlockGraphics(bg)
end procedure

function getAdjacentBlock(bl as Int, dir as String) returns Int
  variable adj set to -1
  variable newCol set to bl mod width
  variable newRow set to divAsInt(bl, width)
  if dir.equals("w") then
    assign newRow to newRow - 1
  elif dir.equals("a") then
    assign newCol to newCol - 1
  elif dir.equals("s") then
    assign newRow to newRow + 1
  elif dir.equals("d") then
    assign newCol to newCol + 1
  end if
  if (newCol >= 0) and (newCol < width) and (newRow >= 0) and (newRow < height) then
    assign adj to newRow*width + newCol
  end if
  return adj
end function

test test_getAdjacentBlock
  variable bl set to 617
  assert getAdjacentBlock(bl, "w") evaluates to 577
  assert getAdjacentBlock(bl, "a") evaluates to 616
  assert getAdjacentBlock(bl, "s") evaluates to 657
  assert getAdjacentBlock(bl, "d") evaluates to 618
  # boundary
  assert getAdjacentBlock(20, "w") evaluates to -1
  assert getAdjacentBlock(40, "a") evaluates to -1
  assert getAdjacentBlock(1180, "s") evaluates to -1
  assert getAdjacentBlock(79, "d") evaluates to -1
end test

# 2b562d53da91a402709c3043f1ef6b3f186daa9c7366787a816b8465fd19ce5a Elan 2.0.0-beta4 valid

# Use the w,a,s,d keys to change snake's direction
main
  variable bg set to new BlockGraphics()
  variable head set to 620
  variable snake set to [head, 619]
  variable currentDir set to "d"
  variable gameOn set to true
  variable apple set to 0
  variable newApple set to true
  while gameOn
    while newApple
      assign apple to bg.blockNo(randint(0, 39), randint(0, 29))
      if not snake.contains(apple) then
        assign newApple to false
      end if
    end while
    call updateDisplay(bg, snake, apple)
    variable key set to getKey()
    if not key.equals("") and "wasd".contains(key) then
      assign currentDir to key
    end if
    assign head to getAdjacentBlock(head, currentDir, bg)
    if (head is -1) or snake.contains(head) then
      assign gameOn to false
    else
      call snake.prepend(head)
    end if
    if head.equals(apple) then
      assign newApple to true
    else
      call snake.removeAt(snake.length() - 1)
    end if
    call sleep_ms(150)
  end while
  print($"Game Over! Score: {snake.length() - 1}")
end main

procedure updateDisplay(bg as BlockGraphics, snake as List<of Int>, apple as Int)
  call bg.colourAll(white)
  for bl in snake
    call bg.putBlockNo(bl, green)
  end for
  call bg.putBlockNo(apple, red)
  call displayBlockGraphics(bg)
end procedure

function getAdjacentBlock(bl as Int, dir as String, bg as BlockGraphics) returns Int
  variable newCol set to bg.col(bl)
  variable newRow set to bg.row(bl)
  if dir.equals("a") then
    assign newCol to newCol - 1
  elif dir.equals("d") then
    assign newCol to newCol + 1
  elif dir.equals("w") then
    assign newRow to newRow - 1
  elif dir.equals("s") then
    assign newRow to newRow + 1
  end if
  return bg.blockNo(newCol, newRow)
end function

test test_getAdjacentBlock
  variable bg set to new BlockGraphics()
  variable bl set to 617
  assert getAdjacentBlock(bl, "w", bg) evaluates to 577
  assert getAdjacentBlock(bl, "s", bg) evaluates to 657
  assert getAdjacentBlock(bl, "a", bg) evaluates to 616
  assert getAdjacentBlock(bl, "d", bg) evaluates to 618
  # boundary
  assert getAdjacentBlock(20, "w", bg) evaluates to -1
  assert getAdjacentBlock(1180, "s", bg) evaluates to -1
  assert getAdjacentBlock(40, "a", bg) evaluates to -1
  assert getAdjacentBlock(79, "d", bg) evaluates to -1
end test

# 6c968dfa6a468f1b7c657013e2652dff612a5a034283a256e29e3cdf8596eeae Elan 2.0.0-beta4 valid

# Use the w,a,s,d keys to change snake's direction
main
  variable bg set to new BlockGraphics()
  variable head set to 2015
  variable tail set to head
  variable body set to [head]
  variable currentDir set to "d"
  variable gameOn set to true
  variable apple set to 0
  variable changeApplePosition set to true
  while gameOn
    while changeApplePosition
      assign apple to bg.blockNo(randint(0, 39), randint(0, 29))
      if not body.contains(apple) then
        assign changeApplePosition to false
      end if
    end while
    call updateDisplay(bg, head, tail, body, apple)
    variable key set to getKey()
    if not key.equals("") and "wasd".contains(key) then
      assign currentDir to key
    end if
    assign tail to body[0]
    call body.append(head)
    assign head to getAdjacentBlock(head, currentDir, bg)
    assign gameOn to not hasHitEdge(head, bg) and not body.contains(head)
    if head.equals(apple) then
      assign changeApplePosition to true
    else
      call body.removeAt(0)
    end if
    call sleep_ms(150)
  end while
  print($"Game Over! Score: {body.length() - 1}")
end main

procedure updateDisplay(bg as BlockGraphics, head as Int, tail as Int, body as List<of Int>, apple as Int)
  call bg.put(bg.col(head), bg.row(head), green)
  variable tailColour set to getTailColour(tail, body)
  call bg.put(bg.col(tail), bg.row(tail), tailColour)
  call bg.put(bg.col(apple), bg.row(apple), red)
  call bg.display()
end procedure

function getTailColour(tail as Int, body as List<of Int>) returns Int
  variable colour set to white
  if body[0].equals(tail) then
    assign colour to green
  end if
  return colour
end function

function hasHitEdge(head as Int, bg as BlockGraphics) returns Boolean
  variable headX set to bg.col(head)
  variable headY set to bg.row(head)
  return (headX < 0) or (headY < 0) or (headX > 39) or (headY > 29)
end function

function getAdjacentBlock(bl as Int, dir as String, bg as BlockGraphics) returns Int
  variable newX set to bg.col(bl)
  variable newY set to bg.row(bl)
  if dir.equals("a") then
    assign newX to newX - 1
  elif dir.equals("d") then
    assign newX to newX + 1
  elif dir.equals("w") then
    assign newY to newY - 1
  elif dir.equals("s") then
    assign newY to newY + 1
  end if
  return bg.blockNo(newX, newY)
end function

test test_getTailColour
  assert getTailColour(0304, [0304, 0305]) evaluates to green
  assert getTailColour(0304, [0305, 0306]) evaluates to white
end test

test test_hasHitEdge
  variable bg set to new BlockGraphics()
  assert hasHitEdge(0000, bg) evaluates to false
  assert hasHitEdge(0029, bg) evaluates to false
  assert hasHitEdge(3900, bg) evaluates to false
  assert hasHitEdge(3929, bg) evaluates to false
  assert hasHitEdge(-0105, bg) evaluates to true
  assert hasHitEdge(0530, bg) evaluates to true
  assert hasHitEdge(4005, bg) evaluates to true
  assert hasHitEdge(0499, bg) evaluates to true
  assert hasHitEdge(1499, bg) evaluates to true
  assert hasHitEdge(-85, bg) evaluates to true
end test

test test_getAdjacentBlock
  variable bg set to new BlockGraphics()
  variable bl set to 2015
  assert getAdjacentBlock(bl, "w", bg) evaluates to 2014
  assert getAdjacentBlock(bl, "s", bg) evaluates to 2016
  assert getAdjacentBlock(bl, "a", bg) evaluates to 1915
  assert getAdjacentBlock(bl, "d", bg) evaluates to 2115
  # boundary
  assert getAdjacentBlock(0015, "a", bg) evaluates to -85
end test

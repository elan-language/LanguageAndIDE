# 9fe56259e16bc6a7abe4c7d615411023090127177c0ec1261c92d81b3a60dcc4 Elan 2.0.0-beta4 valid

main
  variable rng set to new Random()
  call rng.initialiseFromClock()
  variable grid set to initialGrid(rng)
  while true
    call displayBlockGraphics(grid)
    assign grid to nextGeneration(grid)
    call sleep_ms(50)
  end while
end main

function initialGrid(rng as Random) returns BlockGraphics
  variable grid set to new BlockGraphics()
  variable cells set to range(0, 1199)
  return cells.reduce((grid, rng), initialCell).item_0
end function

function initialCell(acc as (BlockGraphics, Random), cell as Int) returns (BlockGraphics, Random)
  variable bg set to acc.item_0
  variable rng set to acc.item_1
  variable colour set to blackOrWhite(rng)
  return (bg.withPutBlockNo(cell, colour), rng.nextGen())
end function

test test_initialGrid
  variable grid set to initialGrid(new Random())
  assert grid.get(0, 0) evaluates to black
  assert grid.get(1, 0) evaluates to white
  assert grid.get(2, 0) evaluates to black
  assert grid.get(0, 1) evaluates to white
  assert grid.get(1, 1) evaluates to black
  assert grid.get(2, 1) evaluates to white
  assert grid.get(0, 2) evaluates to black
  assert grid.get(1, 2) evaluates to white
  assert grid.get(2, 2) evaluates to black
end test

function blackOrWhite(rng as Random) returns Int
  return if_(rng.asFloat() > 0.5, white, black)
end function

test test_blackOrWhite
  variable rng0 set to new Random()
  variable rng1 set to rng0.nextGen()
  variable rng2 set to rng1.nextGen()
  variable rng3 set to rng2.nextGen()
  assert blackOrWhite(rng0) evaluates to black
  assert blackOrWhite(rng1) evaluates to white
  assert blackOrWhite(rng2) evaluates to black
  assert blackOrWhite(rng3) evaluates to black
end test

function x(cell as Int) returns Int
  return cell mod 40
end function

function y(cell as Int) returns Int
  return divAsInt(cell, 40)
end function

function cellNo(x as Int, y as Int) returns Int
  return y*40 + x
end function

function north(cell as Int) returns Int
  variable x set to x(cell)
  variable y set to y(cell)
  variable y2 set to if_(y is 0, 29, y - 1)
  return cellNo(x, y2)
end function

test test_north
  assert north(124) evaluates to 84
  assert north(0) evaluates to 1160
  assert north(39) evaluates to 1199
  assert north(1199) evaluates to 1159
  assert north(1160) evaluates to 1120
end test

function south(cell as Int) returns Int
  variable x set to x(cell)
  variable y set to y(cell)
  variable y2 set to if_(y is 29, 0, y + 1)
  return cellNo(x, y2)
end function

test test_south
  assert south(124) evaluates to 164
  assert south(0) evaluates to 40
  assert south(39) evaluates to 79
  assert south(1199) evaluates to 39
  assert south(1160) evaluates to 0
end test

function east(cell as Int) returns Int
  variable x set to x(cell)
  variable y set to y(cell)
  variable x2 set to if_(x is 39, 0, x + 1)
  return cellNo(x2, y)
end function

test test_east
  assert east(124) evaluates to 125
  assert east(0) evaluates to 1
  assert east(39) evaluates to 0
  assert east(1199) evaluates to 1160
  assert east(1160) evaluates to 1161
end test

function west(cell as Int) returns Int
  variable x set to x(cell)
  variable y set to y(cell)
  variable x2 set to if_(x is 0, 39, x - 1)
  return cellNo(x2, y)
end function

test test_west
  assert west(124) evaluates to 123
  assert west(0) evaluates to 39
  assert west(39) evaluates to 38
  assert west(1199) evaluates to 1198
  assert west(1160) evaluates to 1199
end test

function northEast(cell as Int) returns Int
  return north(east(cell))
end function

test test_northEast
  assert northEast(124) evaluates to 85
  assert northEast(0) evaluates to 1161
  assert northEast(39) evaluates to 1160
  assert northEast(1199) evaluates to 1120
  assert northEast(1160) evaluates to 1121
end test

function northWest(cell as Int) returns Int
  return north(west(cell))
end function

test test_northWest
  assert northWest(124) evaluates to 83
  assert northWest(0) evaluates to 1199
  assert northWest(39) evaluates to 1198
  assert northWest(1199) evaluates to 1158
  assert northWest(1160) evaluates to 1159
end test

function southEast(cell as Int) returns Int
  return south(east(cell))
end function

test test_southEast
  assert southEast(124) evaluates to 165
  assert southEast(0) evaluates to 41
  assert southEast(39) evaluates to 40
  assert southEast(1199) evaluates to 0
  assert southEast(1160) evaluates to 1
end test

function southWest(cell as Int) returns Int
  return south(west(cell))
end function

test test_southWest
  assert southWest(124) evaluates to 163
  assert southWest(0) evaluates to 79
  assert southWest(39) evaluates to 78
  assert southWest(1199) evaluates to 38
  assert southWest(1160) evaluates to 39
end test

function neighbourCells(c as Int) returns List<of Int>
  return [northWest(c), north(c), northEast(c), west(c), east(c), southWest(c), south(c), southEast(c)]
end function

test test_neighbourCells
  assert neighbourCells(124) evaluates to [83, 84, 85, 123, 125, 163, 164, 165]
end test

function liveNeighbours(grid as BlockGraphics, cell as Int) returns Int
  variable neighbours set to neighbourCells(cell)
  return neighbours.filter(lambda c as Int => grid.getBlockNo(c) is black).length()
end function

test test_liveNeighbours
  variable grid set to initialGrid(new Random())
  variable live set to liveNeighbours(grid, 41)
  assert live evaluates to 4
end test

function willLive(cell as Int, liveNeighbours as Int) returns Boolean
  return ((cell is black) and (liveNeighbours > 1) and (liveNeighbours < 4)) or ((cell is white) and (liveNeighbours is 3))
end function

test test_willLive
  assert willLive(white, 0) evaluates to false
  assert willLive(white, 1) evaluates to false
  assert willLive(white, 2) evaluates to false
  assert willLive(white, 3) evaluates to true
  assert willLive(white, 4) evaluates to false
  assert willLive(white, 5) evaluates to false
  assert willLive(white, 6) evaluates to false
  assert willLive(white, 7) evaluates to false
  assert willLive(white, 8) evaluates to false
  assert willLive(black, 0) evaluates to false
  assert willLive(black, 1) evaluates to false
  assert willLive(black, 2) evaluates to true
  assert willLive(black, 3) evaluates to true
  assert willLive(black, 4) evaluates to false
  assert willLive(black, 5) evaluates to false
  assert willLive(black, 6) evaluates to false
  assert willLive(black, 7) evaluates to false
  assert willLive(black, 8) evaluates to false
end test

function nextCellValue(grid as BlockGraphics, cell as Int) returns Int
  variable live set to willLive(grid.getBlockNo(cell), liveNeighbours(grid, cell))
  return if_(live, black, white)
end function

function updateCellValue(oldGrid as BlockGraphics, newGrid as BlockGraphics, cell as Int) returns BlockGraphics
  return newGrid.withPutBlockNo(cell, nextCellValue(oldGrid, cell))
end function

test test_nextCellValue
  variable grid set to initialGrid(new Random())
  variable nxt set to nextCellValue(grid, 41)
  assert nxt evaluates to white
end test

function nextGeneration(oldGrid as BlockGraphics) returns BlockGraphics
  variable emptyGrid set to new BlockGraphics()
  return range(0, 1199).reduce(emptyGrid, lambda newGrid as BlockGraphics, c as Int => updateCellValue(oldGrid, newGrid, c))
end function

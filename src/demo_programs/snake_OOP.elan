# 47ca254f540d10fe9fdf09d1db643d84a7eddb0b4f5d2081cfd491854a949758 Elan 2.0.0-beta5 valid

# Use the W,A,S,D keys to change Snake direction
constant width set to 40

constant height set to 30

main
  variable game set to new Game()
  while game.isOn
    call game.clockTick(getKey())
    variable blocks set to new BlockGraphics()
    call game.updateBlocks(blocks)
    call displayBlockGraphics(blocks)
    call sleep_ms(150)
  end while
  print($"Game Over! Score: {game.score()}")
end main

class Game
  constructor()
    assign this.snake to new Snake(620)
    assign this.currentDir to "d"
    assign this.newAppleNeeded to true
    assign this.isOn to true
  end constructor

  private property snake as Snake

  private property currentDir as String

  private property apple as Int

  private property newAppleNeeded as Boolean

  property isOn as Boolean

  procedure newAppleIfNeeded()
    while this.newAppleNeeded or this.snake.bodyCovers(this.apple)
      assign this.apple to randint(0, width*height - 1)
      assign this.newAppleNeeded to false
    end while
  end procedure

  procedure clockTick(key as String)
    call this.newAppleIfNeeded()
    call this.setDirectionIfKeyPress(key)
    #  TODO 3502
    variable snake set to this.snake
    call snake.moveHead(this.currentDir)
    if snake.bodyCovers(this.apple) then
      assign this.newAppleNeeded to true
    elif not snake.dead then
      call snake.moveTail()
    end if
    if snake.dead then
      assign this.isOn to false
    end if
  end procedure

  procedure updateBlocks(blocks as BlockGraphics)
    #  TODO 3502
    variable snake set to this.snake
    call snake.addToBlocks(blocks)
    call blocks.putBlockNo(this.apple, red)
  end procedure

  procedure setDirectionIfKeyPress(key as String)
    if not key.equals("") and "wasd".contains(key) then
      assign this.currentDir to key
    end if
  end procedure

  function score() returns Int
    return this.snake.length() - 1
  end function

  function toString() returns String
    return "undefined"
  end function

end class

class Snake
  constructor(head as Int)
    assign this.head to head
    assign this.body to [this.head - 1, this.head]
  end constructor

  property head as Int

  private property body as List<of Int>

  property dead as Boolean

  procedure moveHead(dir as String)
    variable newCol set to this.head mod width
    variable newRow set to divAsInt(this.head, width)
    if dir.equals("w") then
      assign newRow to newRow - 1
    elif dir.equals("a") then
      assign newCol to newCol - 1
    elif dir.equals("s") then
      assign newRow to newRow + 1
    elif dir.equals("d") then
      assign newCol to newCol + 1
    end if
    assign this.head to -1
    if (newCol >= 0) and (newCol < width) and (newRow >= 0) and (newRow < height) then
      assign this.head to newRow*width + newCol
    end if
    if (this.head is -1) or this.body.contains(this.head) then
      assign this.dead to true
    else
      #  3502
      variable body set to this.body
      call body.append(this.head)
    end if
  end procedure

  procedure moveTail()
    # 3502
    variable body set to this.body
    call body.removeAt(0)
  end procedure

  procedure addToBlocks(blocks as BlockGraphics)
    for block in this.body
      call blocks.putBlockNo(block, green)
    end for
  end procedure

  function bodyCovers(sq as Int) returns Boolean
    return this.body.contains(sq)
  end function

  function length() returns Int
    return this.body.length()
  end function

  function toString() returns String
    return $"a Snake"
  end function

end class

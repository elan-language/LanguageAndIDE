# ea9b35ef31f496083b5aa58c4381ea6672d2da0587e140352b31c3ca480850f2 Elan 2.0.0-beta4 valid

# Use the W,A,S,D keys to change Snake direction
main
  variable board set to new Board()
  variable game set to new Game(board)
  while not game.over()
    call game.clockTick(getKey())
    variable blocks set to new BlockGraphics()
    call game.updateBlocks(blocks)
    call displayBlockGraphics(blocks)
    call sleep_ms(150)
  end while
  print($"Game Over! Score: {game.score()}")
end main

class Game
  constructor(board as Board)
    assign this.board to board
    assign this.snake to new Snake(board)
    assign this.currentDir to Direction.right
    assign this.newAppleNeeded to true
  end constructor

  property board as Board

  private property snake as Snake

  private property currentDir as Direction

  private property apple as Int

  private property newAppleNeeded as Boolean

  procedure newAppleIfNeeded()
    while this.newAppleNeeded
      assign this.apple to randint(0, this.board.maxSquareNo())
      if not this.snake.bodyCovers(this.apple) then
        assign this.newAppleNeeded to false
      end if
    end while
  end procedure

  procedure clockTick(key as String)
    call this.newAppleIfNeeded()
    call this.setDirectionIfKeyPress(key)
    #  TODO 3502
    variable snake set to this.snake
    call snake.moveHead(this.currentDir)
    if snake.bodyCovers(this.apple) then
      assign this.newAppleNeeded to true
    else
      call snake.moveTail()
    end if
  end procedure

  procedure updateBlocks(blocks as BlockGraphics)
    #  TODO 3502
    variable snake set to this.snake
    call snake.addToBlocks(blocks)
    call blocks.putBlockNo(this.apple, red)
  end procedure

  procedure setDirectionIfKeyPress(key as String)
    if key.equals("w") then
      assign this.currentDir to Direction.up
    elif key.equals("s") then
      assign this.currentDir to Direction.down
    elif key.equals("a") then
      assign this.currentDir to Direction.left
    elif key.equals("d") then
      assign this.currentDir to Direction.right
    end if
  end procedure

  function score() returns Int
    return this.snake.length() - 1
  end function

  function over() returns Boolean
    return this.snake.dead
  end function

  function toString() returns String
    return "undefined"
  end function

end class

class Snake
  constructor(board as Board)
    assign this.board to board
    assign this.body to [620, 619]
  end constructor

  private property body as List<of Int>

  property board as Board

  property dead as Boolean

  procedure moveHead(dir as Direction)
    variable head set to this.body[0]
    variable col set to this.board.col(head)
    variable row set to this.board.row(head)
    if dir is Direction.left then
      assign col to col - 1
    elif dir is Direction.right then
      assign col to col + 1
    elif dir is Direction.up then
      assign row to row - 1
    elif dir is Direction.down then
      assign row to row + 1
    end if
    variable newHead set to this.board.squareNo(col, row)
    variable board set to this.board
    if not this.board.isInBounds(col, row) or this.body.contains(newHead) then
      assign this.dead to true
    else
      #  3502
      variable body set to this.body
      call body.prepend(newHead)
    end if
  end procedure

  procedure moveTail()
    # 3502
    variable body set to this.body
    call body.removeAt(this.length() - 1)
  end procedure

  procedure addToBlocks(blocks as BlockGraphics)
    for block in this.body
      call blocks.putBlockNo(block, green)
    end for
  end procedure

  function bodyCovers(sq as Int) returns Boolean
    return this.body.contains(sq)
  end function

  function length() returns Int
    return this.body.length()
  end function

  function toString() returns String
    return $"a Snake of length{this.length()}"
  end function

end class

class Board
  constructor()
    assign this.width to 40
    assign this.height to 30
  end constructor

  private property width as Int

  private property height as Int

  function squareNo(col as Int, row as Int) returns Int
    return row*this.width + col
  end function

  function maxSquareNo() returns Int
    return this.width*this.height - 1
  end function

  function col(squareNo as Int) returns Int
    return squareNo mod this.width
  end function

  function row(squareNo as Int) returns Int
    return divAsInt(squareNo, this.width)
  end function

  function isInBounds(col as Int, row as Int) returns Boolean
    return (col >= 0) and (col < this.width) and (row >= 0) and (row < this.height)
  end function

  function toString() returns String
    return "undefined"
  end function

end class

enum Direction up, down, left, right

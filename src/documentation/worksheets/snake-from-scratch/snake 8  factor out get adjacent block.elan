# d2cc670c990cbb35e032d071f6f0b0aa5e78992d4cb9c58bf992614eccde60a9 Elan 2.0.0-beta4 valid

main
  variable head set to 621
  variable snake set to [617, 618, 619, 620, head]
  while true
    assign head to getAdjacentBlock(head)
    call snake.append(head)
    call snake.removeAt(0)
    call display(snake)
    call sleep_ms(150)
  end while
end main

function getAdjacentBlock(bl as Int) returns Int
  variable adj set to bl + 1
  return adj
end function

procedure display(snake as List<of Int>)
  variable bg set to new BlockGraphics()
  for segment in snake
    call bg.putBlockNo(segment, green)
  end for
  call displayBlockGraphics(bg)
end procedure

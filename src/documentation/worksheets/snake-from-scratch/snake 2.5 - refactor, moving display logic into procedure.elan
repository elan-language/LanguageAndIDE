# 427e8465c949a36f6e5399e3be19265a3f8898874524d3700f7901fec23eeb24 Python with Elan 2.0.0-beta5 valid

main
  variable head set to 620
  variable snake set to [698, 658, 659, 619, head]
  while true
    call display(snake)
    call sleep_ms(150)
    assign head to head + 1
    call snake.append(head)
    call snake.removeAt(0)
  end while
end main

procedure display(snake as List<of Int>)
  variable bg set to new BlockGraphics()
  for segment in snake
    call bg.putBlockNo(segment, green)
  end for
  call displayBlockGraphics(bg)
end procedure

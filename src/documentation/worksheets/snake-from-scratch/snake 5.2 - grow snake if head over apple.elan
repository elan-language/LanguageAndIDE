# 395fbdcd7d2801bddbb7de763435c196775558b59d58680265cf111ed3a46db9 Python with Elan 2.0.0-beta5 valid

main
  variable head set to 621
  variable snake set to [699, 659, 660, 620, head]
  variable direction set to "d"
  variable apple set to randint(0, 1200)
  while true
    call display(snake, apple)
    call sleep_ms(150)
    variable key set to getKey().lowerCase()
    if isValid(key) then
      assign direction to key
    end if
    assign head to getAdjacentBlock(head, direction)
    call snake.append(head)
    if not head.equals(apple) then
      call snake.removeAt(0)
    end if
  end while
end main

procedure display(snake as List<of Int>, apple as Int)
  variable bg set to new BlockGraphics()
  for segment in snake
    call bg.putBlockNo(segment, green)
  end for
  call bg.putBlockNo(apple, red)
  call displayBlockGraphics(bg)
end procedure

function isValid(key as String) returns Boolean
  return (not key.equals("")) and ("wasd".contains(key))
end function

test test_isValid
  assert isValid("w") evaluates to true
  assert isValid("") evaluates to false
  assert isValid("x") evaluates to false
end test

function getAdjacentBlock(block as Int, direction as String) returns Int
  variable adj set to -1
  if direction.equals("d") then
    assign adj to block + 1
  elif direction.equals("s") then
    assign adj to block + 40
  elif direction.equals("w") then
    assign adj to block - 40
  elif direction.equals("a") then
    assign adj to block - 1
  end if
  return adj
end function

test test_getAdjacentBlock
  assert getAdjacentBlock(621, "w") evaluates to 581
  assert getAdjacentBlock(621, "a") evaluates to 620
  assert getAdjacentBlock(621, "s") evaluates to 661
  assert getAdjacentBlock(621, "d") evaluates to 622
end test

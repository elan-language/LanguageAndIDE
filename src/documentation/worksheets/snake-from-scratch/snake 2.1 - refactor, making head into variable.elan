# 31613aeba60aa08ada656936c3658382bd136f9ea7f56f220a2b575a67fd6899 Python with Elan 2.0.0-beta5 valid

main
  variable bg set to new BlockGraphics()
  variable head set to 621
  variable snake set to [699, 659, 660, 620, head]
  for segment in snake
    call bg.putBlockNo(segment, green)
  end for
  call displayBlockGraphics(bg)
end main

# 7583f6611b66196e379a5eb76b9323cef13a76fd0f8af4e4591bba39e0943218 Elan 2.0.0-beta4 valid

main
  variable head set to 621
  variable snake set to [620, head]
  variable direction set to "d"
  variable gameOn set to true
  variable apple set to -1
  while gameOn
    while (apple is -1) or snake.contains(apple)
      assign apple to randint(0, 1200)
    end while
    call display(snake, apple)
    call sleep_ms(150)
    variable key set to getKey().lowerCase()
    if isValid(key) then
      assign direction to key
    end if
    assign head to getAdjacentBlock(head, direction)
    if (head is -1) or snake.contains(head) then
      assign gameOn to false
    end if
    if head.equals(apple) then
      assign apple to -1
    else
      call snake.removeAt(0)
    end if
    call snake.append(head)
  end while
  print($"Game Over! Score: {snake.length() - 2}")
end main

function isValid(key as String) returns Boolean
  return (not key.equals("")) and ("wasd".contains(key))
end function

test test_isValid
  assert isValid("w") evaluates to true
  assert isValid("") evaluates to false
  assert isValid("x") evaluates to false
end test

function getAdjacentBlock(bl as Int, direction as String) returns Int
  variable adj set to -1
  if direction.equals("d") and ((bl mod 40) < 39) then
    assign adj to bl + 1
  elif direction.equals("s") and (bl < 1160) then
    assign adj to bl + 40
  elif direction.equals("w") and (bl > 39) then
    assign adj to bl - 40
  elif direction.equals("a") and ((bl mod 40) > 0) then
    assign adj to bl - 1
  end if
  return adj
end function

test test_getAdjacentBlock
  assert getAdjacentBlock(119, "d") evaluates to -1
  assert getAdjacentBlock(600, "a") evaluates to -1
  assert getAdjacentBlock(7, "w") evaluates to -1
  assert getAdjacentBlock(1190, "s") evaluates to -1
end test

procedure display(snake as List<of Int>, apple as Int)
  variable bg set to new BlockGraphics()
  for segment in snake
    call bg.putBlockNo(segment, green)
  end for
  call bg.putBlockNo(apple, red)
  call displayBlockGraphics(bg)
end procedure

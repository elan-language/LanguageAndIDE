# 8381311099f4ab19282aa282a4eec66ddb423e9003f604fd0bf4ac774af47cc1 Elan 2.0.0-beta4 valid

constant border set to 0x004472C4

constant leftEdge set to 15

constant rightEdge set to 24

constant topEdge set to 10

main
  variable bg set to new BlockGraphics()
  call drawBackground(bg)
  variable gameOver set to false
  variable score set to 0
  variable delay set to 0.3
  while not gameOver
    call processNewShape(bg, delay)
    call removeCompletedRows(bg)
    assign score to score + 1
    assign gameOver to checkForGameOver(bg)
    assign delay to delay - 0.01
  end while
  print("Game Over! Score: ")
  print(score)
end main

procedure processNewShape(bg as BlockGraphics, delay as Float)
  variable shapes set to [[-1, 0, 1, 2], [0, 1, 40, 41], [-1, 0, 1, 40], [-1, 0, 1, 39], [-1, 0, 1, 41], [0, 1, 39, 40], [-1, 0, 40, 41]]
  variable colours set to [red, yellow, blue, green, brown, grey, white]
  variable shapeNo set to randint(0, 6)
  variable shape set to shapes[shapeNo]
  variable shapeColour set to colours[shapeNo]
  variable position set to 420
  call drawShape(shape, position, shapeColour, bg)
  variable moving set to true
  while moving
    call clearKeyBuffer()
    call sleep(delay)
    call eraseShape(shape, position, bg)
    variable key set to getKey()
    assign shape to rotateShapeFromKey(shape, position, key, bg)
    variable newPosition set to newPositionFromKey(shape, position, key, bg)
    if allSquaresValid(shape, newPosition, bg) then
      assign position to newPosition
    else
      assign moving to false
    end if
    call drawShape(shape, position, shapeColour, bg)
    if key.equals("ArrowDown") then
      call rapidDrop(shape, position, shapeColour, bg)
      assign moving to false
    end if
  end while
end procedure

procedure drawBackground(bg as BlockGraphics)
  for row in range(0, 30)
    for col in range(0, 40)
      variable colour set to border
      if (row >= topEdge) and (col >= leftEdge) and (col <= rightEdge) then
        assign colour to black
      end if
      call bg.put(col, row, colour)
    end for
  end for
  call displayBlockGraphics(bg)
end procedure

procedure drawShape(shape as List<of Int>, position as Int, colour as Int, bg as BlockGraphics)
  for blockNo in shape
    call bg.putBlockNo(blockNo + position, colour)
  end for
  call displayBlockGraphics(bg)
end procedure

procedure eraseShape(shape as List<of Int>, position as Int, bg as BlockGraphics)
  call drawShape(shape, position, black, bg)
end procedure

procedure rapidDrop(shape as List<of Int>, startPosition as Int, colour as Int, bg as BlockGraphics)
  variable moving set to true
  variable position set to startPosition
  while moving
    call eraseShape(shape, position, bg)
    variable newPosition set to position + 40
    if allSquaresValid(shape, newPosition, bg) then
      assign position to newPosition
    else
      assign moving to false
    end if
    call drawShape(shape, position, colour, bg)
  end while
end procedure

procedure removeCompletedRows(bg as BlockGraphics)
  variable row set to 29
  while row >= topEdge
    if isComplete(row, bg) then
      call removeRow(row, bg)
    else
      assign row to row - 1
    end if
  end while
end procedure

procedure removeRow(emptyRow as Int, bg as BlockGraphics)
  for row in rangeInSteps(emptyRow, topEdge, -1)
    for col in range(leftEdge, rightEdge + 1)
      call bg.put(col, row, bg.get(col, row - 1))
    end for
  end for
end procedure

function isComplete(row as Int, bg as BlockGraphics) returns Boolean
  variable result set to true
  for col in range(11, 29)
    if bg.get(col, row) is black then
      assign result to false
    end if
  end for
  return result
end function

function allSquaresValid(shape as List<of Int>, position as Int, bg as BlockGraphics) returns Boolean
  variable result set to true
  for relative in shape
    variable blockNo set to position + relative
    assign result to result and withinBoundsAndEmpty(blockNo, bg)
  end for
  return result
end function

function withinBoundsAndEmpty(blockNo as Int, bg as BlockGraphics) returns Boolean
  return (blockNo < 1200) and (bg.getBlockNo(blockNo) is black)
end function

function newPositionFromKey(shape as List<of Int>, position as Int, key as String, bg as BlockGraphics) returns Int
  variable result set to position
  variable newPos set to position
  if key.equals("ArrowRight") then
    assign newPos to position + 1
  elif key.equals("ArrowLeft") then
    assign newPos to position - 1
  end if
  if allSquaresValid(shape, newPos, bg) then
    assign result to newPos
  end if
  return result + 40
end function

function rotateShapeFromKey(shape as List<of Int>, position as Int, key as String, bg as BlockGraphics) returns List<of Int>
  variable result set to shape
  variable newShape set to shape
  if key.equals("ArrowUp") then
    assign newShape to quarterTurn(shape)
  end if
  if allSquaresValid(newShape, position, bg) then
    assign result to newShape
  end if
  return result
end function

function quarterTurn(shape as List<of Int>) returns List<of Int>
  variable result set to new List<of Int>()
  for blockNo in shape
    assign result to result.withAppend(mapRotationAntiClockwise(blockNo))
  end for
  return result
end function

function mapRotationAntiClockwise(blockNo as Int) returns Int
  variable fromBlock set to [-82, -81, -80, -79, -78, -42, -41, -40, -39, -38, -2, -1, 0, 1, 2, 38, 39, 40, 41, 42, 78, 79, 80, 81, 82]
  variable index set to fromBlock.indexOf(blockNo)
  variable toBlock set to [78, 38, -2, -42, -82, 79, 39, -1, -41, -81, 80, 40, 0, -40, -80, 81, 41, 1, -39, -79, 82, 42, 2, -38, -78]
  return toBlock[index]
end function

function checkForGameOver(bg as BlockGraphics) returns Boolean
  variable gameOver set to false
  for x in range(leftEdge, rightEdge + 1)
    if bg.get(x, topEdge) isnt black then
      assign gameOver to true
    end if
  end for
  return gameOver
end function

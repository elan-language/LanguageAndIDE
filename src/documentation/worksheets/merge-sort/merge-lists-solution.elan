# 48026bac43bdd5237a5e4609aca4fe4bf778cdf9792864802d04ce96a435126e Elan 2.0.0-beta5 valid

function merge(a as List<of String>, b as List<of String>) returns List<of String>
  variable result set to new List<of String>()
  if a.length() is 0 then
    assign result to b
  elif b.length() is 0 then
    assign result to a
  elif a[0].isBefore(b[0]) then
    # assign result to .subList(a[0]].withAppendList(merge(a[1, .length()), b))
  else
    # assign result to .subList(b[0]].withAppendList(merge(a, b[1, .length())))
  end if
  return result
end function
